# Claude Console > study-dev 워크스페이스 > 키 이름 blog-local
ANTHROPIC_API_KEY=REPLACE_ME
# 로컬 docker-compose Postgres (BE/docker-compose.yml)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# 임베딩 방식: api면 EMBEDDING_API_KEY를 검사하고, local(로컬 모델)이면 검사하지 않는다
EMBEDDING_PROVIDER=local
# 로컬 임베딩 모델 이름(Hugging Face). 1024차원 모델만 지금 스키마와 맞는다
EMBEDDING_MODEL=BAAI/bge-m3
# 임베딩 API 제공자 콘솔에서 발급 (제공자 미정, EMBEDDING_PROVIDER=api일 때만 필요)
EMBEDDING_API_KEY=REPLACE_ME
# LangSmith > Settings > API Keys
LANGSMITH_API_KEY=REPLACE_ME
LANGSMITH_TRACING=false
# 웹 서버(python -m blog_rag_agent.api). 비밀값 두 개는 32자 이상, 각각 아래로 만든다:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# ACCESS_CODE_PEPPER를 바꾸면 이미 발급한 접근 코드가 모두 무효가 된다.
ACCESS_CODE_PEPPER=REPLACE_ME
# 바꾸면 열려 있는 세션 쿠키가 모두 무효가 된다.
SESSION_SECRET=REPLACE_ME
# 코드 발급 때 --limit을 안 주면 쓰는 하루 질문 수(Asia/Seoul 자정 기준)
DAILY_QUESTION_LIMIT=20
# LLM 호출 한 번의 max_tokens(grade·rewrite·answer 공통)
ANSWER_MAX_TOKENS=1024
# 단가표(api/settings.py PRICES_PER_MTOK)에 있는 모델만 허용
CHAT_MODEL=claude-haiku-5-5
